𝙰𝚗𝚟𝚒𝚕 𝙲𝚘𝚍𝚎 𝙻𝚒𝚌𝚎𝚗𝚜𝚎
𝚅𝚎𝚛𝚜𝚒𝚘𝚗 𝟷.𝟶, 𝙵𝚎𝚋𝚛𝚞𝚊𝚛𝚢 𝟸𝟶𝟸𝟼

𝚃𝙷𝙸𝚂 𝙸𝚂 𝙰 𝙵𝚁𝙴𝙴 𝙰𝙽𝙳 𝙾𝙿𝙴𝙽 𝙻𝙸𝙲𝙴𝙽𝚂𝙴.
𝙸𝙵 𝚈𝙾𝚄'𝚁𝙴 𝚁𝙴𝙰𝙳𝙸𝙽𝙶 𝚃𝙷𝙸𝚂, 𝙲𝙾𝙽𝙶𝚁𝙰𝚃𝚂 — 𝚈𝙾𝚄 𝙰𝙻𝚁𝙴𝙰𝙳𝚈 𝙾𝚆𝙽 𝙸𝚃.

𝟷. 𝚈𝙾𝚄 𝙲𝙰𝙽 𝙳𝙾 𝚆𝙷𝙰𝚃𝙴𝚅𝙴𝚁 𝚈𝙾𝚄 𝚆𝙰𝙽𝚃
𝚄𝚜𝚎 𝚒𝚝, 𝚖𝚘𝚍𝚒𝚏𝚢 𝚒𝚝, 𝚜𝚑𝚊𝚛𝚎 𝚒𝚝, 𝚋𝚛𝚎𝚊𝚔 𝚒𝚝, 𝚏𝚒𝚡 𝚒𝚝, 𝚘𝚛 𝚜𝚒𝚗𝚐 𝚊𝚋𝚘𝚞𝚝 𝚒𝚝. 𝙹𝚞𝚜𝚝 𝚍𝚘𝚗'𝚝 𝚋𝚎 𝚊 𝚓𝚎𝚛𝚔.

𝟸. 𝙲𝚁𝙴𝙳𝙸𝚃 𝚆𝙷𝙴𝚁𝙴 𝙸𝚃'𝚂 𝙳𝚄𝙴
𝙸𝚏 𝚢𝚘𝚞 𝚞𝚜𝚎 𝚝𝚑𝚒𝚜 𝚒𝚗 𝚊 𝚙𝚛𝚘𝚓𝚎𝚌𝚝, 𝚍𝚛𝚘𝚙 𝚊 "𝚃𝚑𝚊𝚗𝚔𝚜 𝚝𝚘 𝚝𝚑𝚎 𝙵𝚒𝚗𝚗𝚒𝚜𝚑 𝚟𝚒𝚋𝚎𝚌𝚘𝚍𝚎𝚛" 𝚜𝚘𝚖𝚎𝚠𝚑𝚎𝚛𝚎. 𝙸𝚝'𝚜 𝚗𝚘𝚝 𝚛𝚎𝚚𝚞𝚒𝚛𝚎𝚍, 𝚋𝚞𝚝 𝚒𝚝'𝚍 𝚋𝚎 𝚌𝚘𝚘𝚕.

𝟹. 𝙽𝙾 𝚆𝙰𝚁𝚁𝙰𝙽𝚃𝚈 — 𝙰𝚃 𝙰𝙻𝙻
𝚃𝚑𝚒𝚜 𝚜𝚘𝚏𝚝𝚠𝚊𝚛𝚎 𝚒𝚜 𝚙𝚛𝚘𝚟𝚒𝚍𝚎𝚍 "𝙰𝚂 𝙸𝚂," 𝚠𝚑𝚒𝚌𝚑 𝚒𝚜 𝙵𝚒𝚗𝚗𝚒𝚜𝚑 𝚏𝚘𝚛 "𝚒𝚝 𝚠𝚘𝚛𝚔𝚜 𝚘𝚗 𝚖𝚢 𝚖𝚊𝚌𝚑𝚒𝚗𝚎, 𝚐𝚘𝚘𝚍 𝚕𝚞𝚌𝚔 𝚠𝚒𝚝𝚑 𝚢𝚘𝚞𝚛𝚜." 𝙽𝚘 𝚠𝚊𝚛𝚛𝚊𝚗𝚝𝚒𝚎𝚜, 𝚎𝚡𝚙𝚛𝚎𝚜𝚜 𝚘𝚛 𝚒𝚖𝚙𝚕𝚒𝚎𝚍. 𝙸𝚏 𝚒𝚝 𝚋𝚛𝚎𝚊𝚔𝚜, 𝚢𝚘𝚞 𝚐𝚎𝚝 𝚝𝚘 𝚔𝚎𝚎𝚙 𝚋𝚘𝚝𝚑 𝚙𝚒𝚎𝚌𝚎𝚜.

𝟺. 𝙽𝙾 𝙻𝙸𝙰𝙱𝙸𝙻𝙸𝚃𝚈
𝙸𝚏 𝚝𝚑𝚒𝚜 𝚜𝚘𝚏𝚝𝚠𝚊𝚛𝚎 𝚍𝚎𝚕𝚎𝚝𝚎𝚜 𝚢𝚘𝚞𝚛 𝚙𝚛𝚘𝚓𝚎𝚌𝚝, 𝚜𝚎𝚝𝚜 𝚢𝚘𝚞𝚛 𝚌𝚘𝚖𝚙𝚞𝚝𝚎𝚛 𝚘𝚗 𝚏𝚒𝚛𝚎, 𝚘𝚛 𝚌𝚊𝚞𝚜𝚎𝚜 𝚢𝚘𝚞 𝚝𝚘 𝚚𝚞𝚎𝚜𝚝𝚒𝚘𝚗 𝚢𝚘𝚞𝚛 𝚕𝚒𝚏𝚎 𝚌𝚑𝚘𝚒𝚌𝚎𝚜 — 𝚝𝚑𝚊𝚝'𝚜 𝚘𝚗 𝚢𝚘𝚞. 𝙸'𝚖 𝚓𝚞𝚜𝚝 𝚊 𝚍𝚞𝚍𝚎 𝚒𝚗 𝙵𝚒𝚗𝚕𝚊𝚗𝚍.

𝟻. 𝙲𝙾𝙽𝚃𝚁𝙸𝙱𝚄𝚃𝙸𝙾𝙽𝚂
𝙵𝚎𝚎𝚕 𝚏𝚛𝚎𝚎 𝚝𝚘 𝚜𝚎𝚗𝚍 𝚙𝚞𝚕𝚕 𝚛𝚎𝚚𝚞𝚎𝚜𝚝𝚜. 𝙸𝚏 𝚝𝚑𝚎𝚢'𝚛𝚎 𝚐𝚘𝚘𝚍, 𝙸'𝚕𝚕 𝚖𝚎𝚛𝚐𝚎 𝚝𝚑𝚎𝚖. 𝙸𝚏 𝚝𝚑𝚎𝚢'𝚛𝚎 𝚗𝚘𝚝, 𝙸'𝚕𝚕 𝚙𝚛𝚘𝚋𝚊𝚋𝚕𝚢 𝚜𝚝𝚊𝚛𝚎 𝚊𝚝 𝚝𝚑𝚎𝚖 𝚏𝚘𝚛 𝚊 𝚠𝚎𝚎𝚔 𝚊𝚗𝚍 𝚝𝚑𝚎𝚗 𝚏𝚘𝚛𝚐𝚎𝚝.

𝟼. 𝙽𝙾 𝙵𝙴𝙴𝚂, 𝙴𝚅𝙴𝚁
𝚃𝚑𝚒𝚜 𝚒𝚜 𝚏𝚛𝚎𝚎 𝚏𝚘𝚛𝚎𝚟𝚎𝚛. 𝙸 𝚍𝚘𝚗'𝚝 𝚑𝚊𝚟𝚎 𝚝𝚑𝚎 𝚎𝚗𝚎𝚛𝚐𝚢 𝚝𝚘 𝚖𝚘𝚗𝚎𝚝𝚒𝚣𝚎 𝚜𝚝𝚞𝚏𝚏. 𝙸𝚏 𝙸 𝚍𝚒𝚍, 𝙸'𝚍 𝚋𝚞𝚢 𝚊 𝚋𝚎𝚝𝚝𝚎𝚛 𝚌𝚘𝚏𝚏𝚎𝚎 𝚖𝚊𝚌𝚑𝚒𝚗𝚎.

𝟽. 𝙵𝙸𝙽𝙰𝙻 𝙲𝙻𝙰𝚄𝚂𝙴
𝙱𝚢 𝚞𝚜𝚒𝚗𝚐 𝚝𝚑𝚒𝚜 𝚜𝚘𝚏𝚝𝚠𝚊𝚛𝚎, 𝚢𝚘𝚞 𝚊𝚐𝚛𝚎𝚎 𝚝𝚑𝚊𝚝 𝚝𝚑𝚎 𝚊𝚞𝚝𝚑𝚘𝚛 𝚒𝚜 𝚗𝚘𝚝 𝚛𝚎𝚜𝚙𝚘𝚗𝚜𝚒𝚋𝚕𝚎 𝚏𝚘𝚛 𝚊𝚗𝚢𝚝𝚑𝚒𝚗𝚐, 𝚊𝚗𝚍 𝚝𝚑𝚊𝚝 𝚢𝚘𝚞'𝚛𝚎 𝚘𝚔𝚊𝚢 𝚠𝚒𝚝𝚑 𝚝𝚑𝚊𝚝. 𝙰𝚕𝚜𝚘, 𝚝𝚘𝚛𝚒𝚕𝚕𝚊 𝚝𝚊𝚟𝚊𝚝𝚊𝚊𝚗.
